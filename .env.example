# AITER COMMERCE — environment configuration.
#
# Copy to `.env` (already gitignored — never commit real values) and fill in
# your own values. Load with `set -a && source .env && set +a`, or however
# your shell / process manager loads dotfiles.
#
# Every variable below is OPTIONAL except the two Razorpay keys.

# --- Razorpay (payments rail, issues #18 / #23) -----------------------------
#
# API key pair from the Razorpay Dashboard (Settings → API Keys).
# Sandbox/test keys start with `rzp_test_`, live keys with `rzp_live_`.
# These are REQUIRED: aiter-server refuses to build a Razorpay client without
# them. They are never logged and never committed.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Explicit payment mode: `sandbox` (default) or `live`. An unknown value is a
# startup error. Razorpay serves both modes from the same API host; the key
# pair (test vs live) is what actually selects the mode.
RAZORPAY_MODE=sandbox

# Optional override of the Razorpay API base URL. Defaults to
# https://api.razorpay.com (the documented sandbox/live host). Set this only
# for a sandbox gateway, proxy, or a local mock server — never in production.
# RAZORPAY_BASE_URL=https://api.razorpay.com

# Secret used to verify Razorpay webhook signatures (`x-razorpay-signature`,
# HMAC-SHA256 over the raw body). Generate it in the Razorpay Dashboard
# (Settings → Webhooks). REQUIRED for `POST /webhooks/razorpay`: without it
# webhook processing fails closed (every webhook is refused). Never committed.
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# --- Server ----------------------------------------------------------------
#
# HTTP port for aiter-server (default 8080).
# PORT=8080